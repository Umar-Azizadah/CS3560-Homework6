
@startuml
title School Facility Rental - Activity Diagram

|Renter|
start
:Choose facility, date, time, and event type;

|Website|
:Check availability;

while (Facility available?) is ([not available])
    :Show not available;

    |Renter|
    if (Choose another date?) then (yes)
        :Choose a new date or time;
        |Website|
        :Check availability;
    else (no)
        stop
    endif
endwhile ([available])

|Renter|
:Enter contact information;
:Submit rental request;

|Website|
:Record request;

|School Staff|
:Review rental request;

if (Approve request?) then ([approved])

    |Website|
    :Request payment;

    |Payment Service|
    :Charge renter;

    |Website|
    if (Payment successful?) then ([payment succeeds])
        :Save booking;

        |Email Service|
        :Send confirmation email;

        |Renter|
        :Receive confirmation;
        stop

    else ([payment fails])
        :Record payment failure;

        |Email Service|
        :Send payment failure email;
        stop
    endif

else ([rejected])

    |Website|
    :Record rejection;

    |Email Service|
    :Send rejection email;
    stop

endif

@enduml
